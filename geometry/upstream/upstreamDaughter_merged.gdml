<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE gdml [
<!ENTITY matrices SYSTEM "../matrices.xml">
<!ENTITY materials SYSTEM "../materials.xml">
]>

<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

<define>
	<!-- &positions;-->
    &matrices;
    
    <constant name="USBoxmother_width" value="1600"/>
    <constant name="USBoxmother_height" value="1600"/>
    <constant name="USBoxmother_length" value="1600"/>
    <constant name="MainCylinderLength" value="572"/>
<!--    <position name="posMainCylinder" unit="mm" x="0" y="0" z="-MainCylinderLength/2"/>--> <!-- upstream end of CW piece is 5250mm with respect to target center -->
    <position name="posMainCylinder" unit="mm" x="0" y="0" z="0"/> <!-- upstream end of CW piece is 5250mm with respect to target center -->
    <constant name="SmallSidePipeL" value="37.85+10+258-sqrt(pow(258,2)-pow(31.88,2))"/>
    <constant name="BigSidePipeL" value="37.85+10+258-sqrt(pow(258,2)-pow(51.3,2))"/>
    <constant name="SmallPipeFlangePosR" value="sqrt(pow(258,2)-pow(30.16,2))-10+SmallSidePipeL"/>
    <constant name="BigPipeFlangePosR" value="sqrt(pow(258,2)-pow(51.3,2))-10+BigSidePipeL"/>
    <rotation name="targetRot" unit="deg" x="0" y="0" z="0"/>


     
</define> 

&materials;

<solids>

    <box lunit="mm" name="boxUpstream" x="USBoxmother_width" y="USBoxmother_height" z="USBoxmother_length"/>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="MainCylinder">
    <zplane rmin="258" rmax="268" z="0"/>
    <zplane rmin="258" rmax="268" z="MainCylinderLength"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="SideBigHoleSub">
    <zplane rmin="0" rmax="51.3" z="0"/>
    <zplane rmin="0" rmax="51.3" z="30"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="SmallHoleSub">
    <zplane rmin="0" rmax="31.88" z="0"/>
    <zplane rmin="0" rmax="31.88" z="20"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="BottomBigHoleSub">
    <zplane rmin="0" rmax="50.9" z="0"/>
    <zplane rmin="0" rmax="50.9" z="30"/>
    </polycone>

    <subtraction name ="MainCylinder1">
    <first ref="MainCylinder"/>
    <second ref="SideBigHoleSub"/>
    <position name="cut_pos1" x="263-30/2" y="0" z="406.4"/>
    <rotation name="Cut_rot1" x="0" y="90" z="0" unit="deg"/>
    </subtraction>

    <subtraction name ="MainCylinder2">
    <first ref="MainCylinder1"/>
    <second ref="SmallHoleSub"/>
    <position name="cut_pos2" x="263-20/2" y="0" z="236.2"/>
    <rotation name="Cut_rot2" x="0" y="90" z="0" unit="deg"/>
    </subtraction>

    <subtraction name ="MainCylinder3">
    <first ref="MainCylinder2"/>
    <second ref="SmallHoleSub"/>
    <position name="cut_pos3" x="263-20/2" y="0" z="101.6"/>
    <rotation name="Cut_rot3" x="0" y="90" z="0" unit="deg"/>
    </subtraction>

    <subtraction name ="MainCylinder4">
    <first ref="MainCylinder3"/>
    <second ref="SmallHoleSub"/>
    <position name="cut_pos4" x="-263+20/2" y="0" z="236.2"/>
    <rotation name="Cut_rot4" x="0" y="-90" z="0" unit="deg"/>
    </subtraction>

    <subtraction name ="MainCylinder5">
    <first ref="MainCylinder4"/>
    <second ref="SideBigHoleSub"/>
    <position name="cut_pos5" x="-263+30/2" y="0" z="406.4"/>
    <rotation name="Cut_rot5" x="0" y="-90" z="0" unit="deg"/>
    </subtraction>

    <subtraction name ="MainCylinder6">
    <first ref="MainCylinder5"/>
    <second ref="SideBigHoleSub"/>
    <position name="cut_pos6" x="0" y="263-30/2" z="406.4"/>
    <rotation name="Cut_rot6" x="-90" y="0" z="0" unit="deg"/>
    </subtraction>

    <subtraction name ="MainCylinder7">
    <first ref="MainCylinder6"/>
    <second ref="SmallHoleSub"/>
    <position name="cut_pos7" x="0" y="263-20/2" z="236.2"/>
    <rotation name="Cut_rot7" x="-90" y="0" z="0" unit="deg"/>
    </subtraction>

    <subtraction name ="MainCylinder8">
    <first ref="MainCylinder7"/>
    <second ref="BottomBigHoleSub"/>
    <position name="cut_pos8" x="0" y="-263+30/2" z="285.8"/>
    <rotation name="Cut_rot8" x="90" y="0" z="0" unit="deg"/>
    </subtraction>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="SmallSidePipeS1">
    <zplane rmin="30.16" rmax="31.88" z="0"/>
    <zplane rmin="30.16" rmax="31.88" z="37.85+10+258-sqrt(pow(258,2)-pow(31.88,2))"/>
    </polycone>

    <polycone aunit="deg" startphi="-13" deltaphi="26" lunit="mm" name="SmallSidePipeSub">
    <zplane rmin="160" rmax="268" z="0"/>
    <zplane rmin="160" rmax="268" z="70"/>
    </polycone>

    <subtraction name ="SmallSidePipeS2">
    <first ref="SmallSidePipeS1"/>
    <second ref="SmallSidePipeSub"/>
    <position name="cut_pos9" x="35" y="0" z="-sqrt(pow(258,2)-pow(30.16,2))" unit="mm"/>
    <rotation name="Cut_rot9" x="0" y="-90" z="0" unit="deg"/>
    </subtraction>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="BigSidePipeS1">
    <zplane rmin="48.4" rmax="51.3" z="0"/>
    <zplane rmin="48.4" rmax="51.3" z="37.85+10+258-sqrt(pow(258,2)-pow(51.3,2))"/>
    </polycone>

    <polycone aunit="deg" startphi="-20" deltaphi="40" lunit="mm" name="BigSidePipeSub">
    <zplane rmin="160" rmax="268" z="0"/>
    <zplane rmin="160" rmax="268" z="110"/>
    </polycone>

    <subtraction name ="BigSidePipeS2">
    <first ref="BigSidePipeS1"/>
    <second ref="BigSidePipeSub"/>
    <position name="cut_pos9" x="55" y="0" z="-sqrt(pow(258,2)-pow(51.3,2))" unit="mm"/>
    <rotation name="Cut_rot9" x="0" y="-90" z="0" unit="deg"/>
    </subtraction>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="BigBottomPipeS1">
    <zplane rmin="48.4" rmax="50.9" z="0"/>
    <zplane rmin="48.4" rmax="50.9" z="37.85+10+258-sqrt(pow(258,2)-pow(50.9,2))"/>
    </polycone>

    <polycone aunit="deg" startphi="-20" deltaphi="40" lunit="mm" name="BigBottomPipeSub">
    <zplane rmin="160" rmax="268" z="0"/>
    <zplane rmin="160" rmax="268" z="110"/>
    </polycone>

    <subtraction name ="BigBottomPipeS2">
    <first ref="BigBottomPipeS1"/>
    <second ref="BigBottomPipeSub"/>
    <position name="cut_pos9" x="55" y="0" z="-sqrt(pow(258,2)-pow(48.4,2))" unit="mm"/>
    <rotation name="Cut_rot9" x="0" y="-90" z="0" unit="deg"/>
    </subtraction>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="SmallPipeEndFlange">
    <zplane rmin="32.64" rmax="56.01" z="0"/>
    <zplane rmin="32.64" rmax="56.01" z="7.45"/>
    <zplane rmin="30.16" rmax="56.01" z="7.45"/>
    <zplane rmin="30.16" rmax="56.01" z="7.45+8.2"/>
    <zplane rmin="19.94" rmax="56.26" z="7.45+8.2"/>
    <zplane rmin="19.94" rmax="56.26" z="7.45+8.2+17.27"/>
    <zplane rmin="0" rmax="34.67" z="7.45+8.2+17.27"/>
    <zplane rmin="0" rmax="34.67" z="7.45+8.2+17.27+12.7"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="BigPipeEndFlange">
    <zplane rmin="51.3" rmax="75.82" z="0"/>
    <zplane rmin="51.3" rmax="75.82" z="8.74"/>
    <zplane rmin="48.39" rmax="75.82" z="8.74"/>
    <zplane rmin="48.39" rmax="75.82" z="8.74+9.83"/>
    <zplane rmin="0" rmax="75.82" z="8.74+9.83"/>
    <zplane rmin="0" rmax="75.82" z="8.74+9.83+19.81"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="EndFlange1">
    <zplane rmin="268" rmax="314.3" z="0"/>
    <zplane rmin="268" rmax="314.3" z="15.8932"/>
    <zplane rmin="174.62" rmax="314.3" z="15.8932"/>
    <zplane rmin="174.62" rmax="314.3" z="15.8932+11.30"/>
    <zplane rmin="19.93" rmax="314.3" z="15.8932+11.30"/>
    <zplane rmin="19.93" rmax="314.3" z="15.8932+11.30+28.45"/>
    <zplane rmin="15.88" rmax="34.92" z="15.8932+11.30+28.45"/>
    <zplane rmin="15.88" rmax="34.92" z="15.8932+11.30+28.45+12.70"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="EndFlange2">
    <zplane rmin="268" rmax="314.3" z="0"/>
    <zplane rmin="268" rmax="314.3" z="15.8932"/>
    <zplane rmin="174.62" rmax="314.3" z="15.8932"/>
    <zplane rmin="174.62" rmax="314.3" z="15.8932+11.30"/>
    <zplane rmin="48.39" rmax="314.3" z="15.8932+11.30"/>
    <zplane rmin="48.39" rmax="314.3" z="15.8932+11.30+28.45"/>
    <zplane rmin="48.39" rmax="75.82" z="15.8932+11.30+28.45"/>
    <zplane rmin="48.39" rmax="75.82" z="15.8932+11.30+28.45+9.83"/>
    <zplane rmin="50.93" rmax="75.82" z="15.8932+11.30+28.45+9.83"/>
    <zplane rmin="50.93" rmax="75.82" z="15.8932+11.30+28.45+9.83+8.71"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="targetS1">
    <zplane rmin="0" rmax="190" z="0"/>
    <zplane rmin="0" rmax="190" z="54.0"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="targetCu">
    <zplane rmin="0" rmax="170" z="0"/>
    <zplane rmin="0" rmax="170" z="30.0"/>
    <zplane rmin="0" rmax="100" z="30.0"/>
    <zplane rmin="0" rmax="100" z="30.0+4"/>
    <zplane rmin="0" rmax="170" z="30.0+4"/>
    <zplane rmin="0" rmax="170" z="30.0+4+20"/>
    </polycone>

    <polycone aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="targetW">
    <zplane rmin="100" rmax="190" z="0"/>
    <zplane rmin="100" rmax="190" z="4.0"/>
    </polycone>

    <torus aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="CuTube"
     rmin="0" rmax="6.35" rtor="145"/> 
     <!--rmin="12.929" rmax="15.875" rtor="165"/> -->

    <torus aunit="deg" startphi="0" deltaphi="360" lunit="mm" name="CuTubeWater"
     rmin="0" rmax="5.46" rtor="145-(6.35-5.46)"/> 
<!--
    <tube aunit="deg" lunit="mm" deltaphi="360" name="target1" rmax="19" rmin="0" z="4"/>
    <tube aunit="deg" lunit="mm" deltaphi="360" name="targetS1" rmax="19" rmin="0" z="54"/>
    <tube aunit="deg" lunit="mm" deltaphi="360" name="targetS2" rmax="19" rmin="10" z="4"/>
    <tube aunit="deg" lunit="mm" deltaphi="360" name="targetS2" rmax="19" rmin="10" z="4"/>
-->
</solids>


<structure>
  
    <volume name="logicMainCylinder">
      <materialref ref="StainlessSteel"/>
      <solidref ref="MainCylinder8"/>
      <auxiliary auxtype="Color" auxvalue="blue"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="1"/>
    </volume>
<!--
    <volume name="logicMainCylinder1">
      <materialref ref="StainlessSteel"/>
      <solidref ref="SmallSidePipeS1"/>
      <auxiliary auxtype="Color" auxvalue="magenta"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="700000"/>
    </volume>

    <volume name="logicMainCylinder2">
      <materialref ref="StainlessSteel"/>
      <solidref ref="SmallSidePipeSub"/>
      <auxiliary auxtype="Color" auxvalue="blue"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="700001"/>
    </volume>

    <volume name="logicMainCylinder3">
      <materialref ref="StainlessSteel"/>
      <solidref ref="SmallSidePipeS2"/>
      <auxiliary auxtype="Color" auxvalue="pink"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="700002"/>
    </volume>
-->

    <volume name="logicSmallSidePipe">
      <materialref ref="StainlessSteel"/>
      <solidref ref="SmallSidePipeS2"/>
      <auxiliary auxtype="Color" auxvalue="red"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="2"/>
    </volume>

    <volume name="logicBigSidePipe">
      <materialref ref="StainlessSteel"/>
      <solidref ref="BigSidePipeS2"/>
      <auxiliary auxtype="Color" auxvalue="red"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="3"/>
    </volume>

    <volume name="logicBigBottomPipe">
      <materialref ref="StainlessSteel"/>
      <solidref ref="BigBottomPipeS2"/>
      <auxiliary auxtype="Color" auxvalue="red"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="4"/>
    </volume>

    <volume name="logicSmallPipeEndFlange">
      <materialref ref="StainlessSteel"/>
      <solidref ref="SmallPipeEndFlange"/>
      <auxiliary auxtype="Color" auxvalue="red"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="5"/>
    </volume>

    <volume name="logicBigPipeEndFlange">
      <materialref ref="StainlessSteel"/>
      <solidref ref="BigPipeEndFlange"/>
      <auxiliary auxtype="Color" auxvalue="red"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="6"/>
    </volume>

    <volume name="logicEndFlange1">
      <materialref ref="StainlessSteel"/>
      <solidref ref="EndFlange1"/>
      <auxiliary auxtype="Color" auxvalue="red"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="7"/>
    </volume>

    <volume name="logicEndFlange2">
      <materialref ref="StainlessSteel"/>
      <solidref ref="EndFlange2"/>
      <auxiliary auxtype="Color" auxvalue="red"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="8"/>
    </volume>

    <volume name="logicTargetCuTubeWater">
      <materialref ref="G4_WATER"/>
      <solidref ref="CuTubeWater"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="Color" auxvalue="blue"/>
    </volume>

    <volume name="logicChilledWaterTube">
      <materialref ref="Copper"/>
      <solidref ref="CuTube"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="Color" auxvalue="magenta"/>
      <physvol name="physTargetCuTubeWater">
	<volumeref ref="logicTargetCuTubeWater"/>
	<position name="pos1" unit= "mm" x="0" y="0" z="0"/>
	<rotationref ref="targetRot"/>
      </physvol>
    </volume>

    <volume name="logicTargetCu">
      <materialref ref="Copper"/>
      <solidref ref="targetCu"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="Color" auxvalue="brown"/>
      <auxiliary auxtype="DetNo" auxvalue="9"/>
      <physvol name="physChilledWateriTube">
	<volumeref ref="logicChilledWaterTube"/>
	<position name="pos1" unit= "mm" x="0" y="0" z="15"/>
	<rotationref ref="targetRot"/>
    </physvol>
    </volume>

    <volume name="logicTargetCW90">
      <materialref ref="CW90"/>
      <solidref ref="targetW"/>
      <auxiliary auxtype="TargetSamplingVolume" auxvalue="PT"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="Color" auxvalue="gray"/>
      <auxiliary auxtype="DetNo" auxvalue="10"/>
    </volume>

    <volume name="logicTarget">
      <materialref ref="Vacuum"/>
      <solidref ref="targetS1"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="Color" auxvalue="magenta"/>
      <physvol name="physTargetCu">
	<volumeref ref="logicTargetCu"/>
	<position name="pos1" unit= "mm" x="0" y="0" z="0"/>
	<rotationref ref="targetRot"/>
      </physvol>
      <physvol name="physTargetCW90">
	<volumeref ref="logicTargetCW90"/>
	<position name="pos1" unit= "mm" x="0" y="0" z="30"/>
	<rotationref ref="targetRot"/>
    </physvol>
    </volume>

    <volume name="logicUpstream">
      <materialref ref="VacuumColl"/>
      <solidref ref="boxUpstream"/>

      <physvol name="physMainCylinder">
        <volumeref ref="logicMainCylinder"/>
        <position name="pos1" unit="mm" x="406.4" y="0" z="0"/>
        <rotation name="rot1" x="0" y="90" z="0" unit="deg"/>
      </physvol>
<!--
      <physvol name="physMainCylinder1">
        <volumeref ref="logicMainCylinder2"/>
        <position name="pos1" unit="mm" x="35" y="0" z="-150"/>
        <rotation name="rot1" x="0" y="90" z="0" unit="deg"/>
      </physvol>

      <physvol name="physMainCylinder2">
        <volumeref ref="logicMainCylinder3"/>
        <positionref ref="posMainCylinder"/>
      </physvol>-->

      <physvol name="physSmallSidePipe1">
        <volumeref ref="logicSmallSidePipe"/>
        <position name="pos2" unit="mm" x="406.4- 101.6" y="0" z="sqrt(pow(258,2)-pow(30.16,2))-10"/>
        <rotation name="rot2" x="0" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physSmallSidePipe2">
        <volumeref ref="logicSmallSidePipe"/>
        <position name="pos2" unit="mm" x="406.4-236.2" y="0" z="sqrt(pow(258,2)-pow(30.16,2))-10"/>
        <rotation name="rot2" x="0" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physSmallSidePipe3">
        <volumeref ref="logicSmallSidePipe"/>
        <position name="pos2" unit="mm" x="406.4-236.2" y="0" z="-sqrt(pow(258,2)-pow(30.16,2))+10"/>
        <rotation name="rot2" x="0" y="180" z="0" unit="deg"/>
      </physvol>

      <physvol name="physSmallSidePipe4">
        <volumeref ref="logicSmallSidePipe"/>
        <position name="pos2" unit="mm" x="406.4-236.2" y="sqrt(pow(258,2)-pow(30.16,2))-10" z="0"/>
        <rotation name="rot2" x="90" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physBigSidePipe1">
        <volumeref ref="logicBigSidePipe"/>
        <position name="pos2" unit="mm" x="0" y="0" z="sqrt(pow(258,2)-pow(48.4,2))-10"/>
        <rotation name="rot2" x="0" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physBigSidePipe2">
        <volumeref ref="logicBigSidePipe"/>
        <position name="pos2" unit="mm" x="0" y="0" z="-sqrt(pow(258,2)-pow(48.4,2))+10"/>
        <rotation name="rot2" x="0" y="180" z="0" unit="deg"/>
      </physvol>

      <physvol name="physBigSidePipe3">
        <volumeref ref="logicBigSidePipe"/>
        <position name="pos2" unit="mm" x="0" y="sqrt(pow(258,2)-pow(48.4,2))-10" z="0"/>
        <rotation name="rot2" x="90" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physBigBottomPipe">
        <volumeref ref="logicBigBottomPipe"/>
        <position name="pos2" unit="mm" x="406.4-285.8" y="-(sqrt(pow(258,2)-pow(48.4,2))-10)" z="0"/>
        <rotation name="rot2" x="-90" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physSmallPipeFlange1">
        <volumeref ref="logicSmallPipeEndFlange"/>
        <position name="pos2" unit="mm" x="406.4- 101.6" y="0" z="SmallPipeFlangePosR"/>
        <rotation name="rot2" x="0" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physSmallPipeFlange2">
        <volumeref ref="logicSmallPipeEndFlange"/>
        <position name="pos2" unit="mm" x="406.4- 236.2" y="0" z="SmallPipeFlangePosR"/>
        <rotation name="rot2" x="0" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physSmallPipeFlange3">
        <volumeref ref="logicSmallPipeEndFlange"/>
        <position name="pos2" unit="mm" x="406.4- 236.2" y="0" z="-SmallPipeFlangePosR"/>
        <rotation name="rot2" x="0" y="180" z="0" unit="deg"/>
      </physvol>

      <physvol name="physSmallPipeFlange4">
        <volumeref ref="logicSmallPipeEndFlange"/>
        <position name="pos2" unit="mm" x="406.4- 236.2" y="SmallPipeFlangePosR" z="0"/>
        <rotation name="rot2" x="90" y="0" z="0" unit="deg"/>
      </physvol>

      <physvol name="physBigPipeFlange1">
        <volumeref ref="logicBigPipeEndFlange"/>
        <position name="pos2" unit="mm" x="0" y="0" z="BigPipeFlangePosR"/>
        <rotation name="rot2" x="0" y="0" z="0" unit="deg"/>
      </physvol> 

      <physvol name="physBigPipeFlange2">
        <volumeref ref="logicBigPipeEndFlange"/>
        <position name="pos2" unit="mm" x="0" y="0" z="-BigPipeFlangePosR"/>
        <rotation name="rot2" x="0" y="180" z="0" unit="deg"/>
      </physvol>

      <physvol name="physBigPipeFlange3">
        <volumeref ref="logicBigPipeEndFlange"/>
