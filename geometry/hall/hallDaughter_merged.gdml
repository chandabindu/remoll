</solids>

<structure>

    <volume name="cylHallDet_1_logic">
      <materialref ref="Vacuum"/>
      <solidref ref="cylHallDet_1"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="99"/>
    </volume>

    <volume name="cylHallDet_2_logic">
      <materialref ref="Vacuum"/>
      <solidref ref="cylHallDet_2"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="101"/>
    </volume>

    <volume name="cylHallDet_3_logic">
      <materialref ref="Vacuum"/>
      <solidref ref="cylHallDet_3"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="103"/>
    </volume>

    <!--Not in use due to volume overlap -->
    <volume name="cylHallDet_4_logic">
      <materialref ref="Vacuum"/>
      <solidref ref="cylHallDet_4"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="105"/>
    </volume>

    <volume name="topwalldet_logic">
      <materialref ref="Vacuum"/>
      <solidref ref="topwalldet_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="107"/>
    </volume>
    <volume name="cylwalldet_logic">
      <materialref ref="Concrete"/>
      <solidref ref="cylwalldet_hole"/>
      <auxiliary auxtype="SensDet" auxvalue="planeDet"/>
      <auxiliary auxtype="DetNo" auxvalue="109"/>
    </volume>


    <volume name="topwall_logic">
      <materialref ref="Concrete"/>
      <!-- <materialref ref="Kryptonite"/> -->
      <solidref ref="topwall_solid"/>
      <!-- <auxiliary auxtype="SensDet" auxvalue="volumeN5010"/> -->
    </volume>

    <volume name="cylwall_logic">
      <materialref ref="Concrete"/>
      <!-- <materialref ref="Kryptonite"/> -->
      <solidref ref="cylwall_hole"/>
      <auxiliary auxtype="SensDet" auxvalue="Hall_Det"/> <!-- NEW Sensitive detector FIXME -->
      <auxiliary auxtype="DetNo" auxvalue="6000"/>
      <!-- <auxiliary auxtype="SensDet" auxvalue="volumeN5009"/> -->
    </volume>

    <volume name="HC_beampipe1_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe1_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5901"/>
    </volume>

    <volume name="HC_beampipe2_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe2_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5902"/>
    </volume>

    <volume name="HC_beampipe3_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe3_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5903"/>
    </volume>

    <volume name="HC_beampipe4_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe4_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5904"/>
    </volume>

    <volume name="HC_beampipe5_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe5_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5905"/>
    </volume>

    <volume name="HC_beampipe6_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe6_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5906"/>
    </volume>

    <volume name="HC_beampipe7_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe7_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5907"/>
    </volume>

    <volume name="HC_beampipe8_logic">
      <materialref ref="G4_Al"/>
      <solidref ref="pipe8_solid"/>
      <auxiliary auxtype="SensDet" auxvalue="CollDet"/>
      <auxiliary auxtype="DetType" auxvalue="lowenergyneutral"/>
      <auxiliary auxtype="DetType" auxvalue="secondaries"/>
      <auxiliary auxtype="DetNo" auxvalue="5908"/>
    </volume>

    <volume name="HC_beampipe9_logic">
      <materialref ref="G4_Al"/>
